#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&pointing_listener {
    status = "okay";
    scroll-layers = <1>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_lclk {
            bindings = <&mkp LCLK>;
            key-positions = <33 34>;
            layers = <0>;
        };

        combo_rclk {
            bindings = <&mkp RCLK>;
            key-positions = <34 35>;
            layers = <0>;
        };

        combo_scroll {
            bindings = <&mo 1>;
            key-positions = <47 48>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC        &kp N1        &kp N2  &kp N3        &kp N4     &kp N5                                      &kp N6     &kp N7  &kp N8     &kp N9   &kp N0                &kp MINUS
&kp LC(SPACE)  &kp Q         &kp W   &kp E         &kp R      &kp T                                       &kp Y      &kp U   &kp I      &kp O    &kp P                 &kp EQUAL
&kp TAB        &kp A         &kp S   &kp D         &kp F      &kp G   &kp GRAVE        &kp LEFT_BRACKET   &kp H      &kp J   &kp K      &kp L    &kp SEMI              &kp TAB
&kp LSHFT      &kp Z         &kp X   &kp C         &kp V      &kp B   &kp NON_US_HASH  &kp RIGHT_BRACKET  &kp N      &kp M   &kp COMMA  &kp DOT  &mt RIGHT_SHIFT FSLH  &kp RSHFT
&kp LCTRL      &kp LEFT_ALT  &mo 3   &kp LEFT_GUI  &kp SPACE  &mo 2   &mo 3            &kp BACKSPACE      &kp ENTER  &none   &none      &mo 2    &kp RIGHT_ALT         &kp RCTRL
            >;
        };

        layer_1 {
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &mkp RCLK  &mkp LCLK  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans                  &trans  &trans  &kp KP_PLUS        &kp KP_MINUS  &kp KP_MULTIPLY  &kp KP_DIVIDE
&trans  &trans  &trans          &kp UP_ARROW    &trans           &trans                  &trans  &trans  &kp LC(BACKSPACE)  &kp KP_N7     &kp KP_N8        &kp KP_N9
&trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans  &trans  &trans  &trans  &trans  &kp SPACE          &kp KP_N4     &kp KP_N5        &kp KP_N6
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans  &kp SEMICOLON      &kp KP_N1     &kp KP_N2        &kp KP_N3
&trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans  &trans  &trans  &trans             &kp KP_N0     &kp KP_DOT       &kp KP_ENTER
            >;
        };

        layer_3 {
            bindings = <
&trans  &kp F1  &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans   &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans   &trans
            >;
        };

        layer_4 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
